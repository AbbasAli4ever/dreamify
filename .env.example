# Copy to .env (git-ignored). Values from Supabase dashboard → Project Settings → API.
# Leave empty to run on local sample data with the mock AI.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

